{
  "schema": 3,
  "required_executas": [
    {
      "tool_id": "bundled:my-first-anna-app",
      "min_version": "0.2.1",
      "version": "latest"
    }
  ],
  "optional_executas": [],
  "host_capabilities": ["llm.sample", "llm.complete", "aps.kv", "aps.files"],
  "system_prompt_addendum": "The user has the Smart Kitchen Assistant app open. It chats about cooking: it suggests dishes from photographed or listed ingredients, teaches how to cook a photographed dish (full ingredient list and steps), and keeps a conversation history in the app sidebar. Vision runs in the app via anna.llm.complete; recipe reasoning runs in the bundled my-first-anna-app Executa via sampling. You do not need to summon any windows.",
  "tags": ["cooking", "kitchen", "recipes", "food", "vision", "assistant"],
  "ui": {
    "bundle": {
      "format": "static-spa",
      "entry": "index.html",
      "external_origins": []
    },
    "views": [
      {
        "name": "main",
        "title": "Smart Kitchen Assistant",
        "default": true,
        "entry": "index.html",
        "default_size": { "w": 980, "h": 720 },
        "min_size": { "w": 420, "h": 520 },
        "resizable": true,
        "movable": true,
        "single_instance": true
      }
    ],
    "host_api": {
      "tools": ["required:bundled:my-first-anna-app"],
      "llm": ["complete"],
      "storage": ["get", "set", "list", "delete"],
      "files": ["upload_init", "upload_finalize", "download_url", "list", "delete"],
      "window": ["set_title"]
    },
    "csp_overrides": {
      "script-src": ["'self'"]
    },
    "state_merge": "last_writer_wins"
  },
  "dev": {
    "fixtures": ["fixtures/*.jsonl"],
    "seed_storage": {},
    "user_id": 1
  }
}
